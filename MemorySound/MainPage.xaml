<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemorySound.MainPage">



    <Grid RowDefinitions ="*, *" ColumnDefinitions ="*, *" RowSpacing="15" ColumnSpacing="15" Padding="15">

        <Button x:Name ="BtnRed" BackgroundColor="Red" Grid.Row="0" Grid.Column="0" Clicked="OnButtonClicked" />
        <Button x:Name ="BtnGreen" BackgroundColor="Green" Grid.Row="0" Grid.Column="1" Clicked="OnButtonClicked"/>
        <Button x:Name ="BtnBlue" BackgroundColor="Blue" Grid.Row="1" Grid.Column="0" Clicked="OnButtonClicked"/>
        <Button x:Name ="BtnYellow" BackgroundColor="Yellow" Grid.Row="1" Grid.Column="1" Clicked="OnButtonClicked"/>

    </Grid>


</ContentPage>
